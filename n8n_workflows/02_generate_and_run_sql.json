      },
      "id": "d4e5f6g7-h8i9-0123-defg-234567890123",
      "name": "Run SQL",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse and format the results\nconst sqlResponse = $('Generate SQL').first().json;\nconst runResponse = $input.first().json;\n\nif (runResponse.type === 'df') {\n  const data = JSON.parse(runResponse.df);\n  \n  return {\n    json: {\n      success: true,\n      question: sqlResponse.text || 'N/A',\n      sql: sqlResponse.text,\n      rows_count: data.length,\n      data: data,\n      cache_id: runResponse.id\n    }\n  };\n} else if (runResponse.type === 'sql_error') {\n  return {\n    json: {\n      success: false,\n      error: runResponse.error,\n      sql: sqlResponse.text\n    }\n  };\n} else {\n  return {\n    json: {\n      success: false,\n      message: 'Unexpected response type',\n      response: runResponse\n    }\n  };\n}"
      },
      "id": "e5f6g7h8-i9j0-1234-efgh-345678901234",
      "name": "Format Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    }
