    {
      "parameters": {
        "jsCode": "// Extract and display the generated SQL\nconst response = $input.first().json;\n\nif (response.type === 'sql') {\n  return {\n    json: {\n      success: true,\n      cache_id: response.id,\n      sql: response.text,\n      type: response.type\n    }\n  };\n} else {\n  return {\n    json: {\n      success: false,\n      message: 'Failed to generate SQL',\n      response: response\n    }\n  };\n}"
      },
