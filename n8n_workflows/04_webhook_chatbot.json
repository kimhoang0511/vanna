    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"Question is required\",\n  \"usage\": \"POST /vanna-chat with body: { \\\"question\\\": \\\"Your question here\\\" }\"\n}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "webhook-03-error",
      "name": "Return Error",
