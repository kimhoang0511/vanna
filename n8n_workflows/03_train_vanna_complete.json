    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "train_ddl",
              "value": "CREATE TABLE public.customers (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(100) NOT NULL,\n    email VARCHAR(100) UNIQUE,\n    country VARCHAR(50),\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\nCREATE TABLE public.orders (\n    id SERIAL PRIMARY KEY,\n    customer_id INTEGER REFERENCES customers(id),\n    order_date DATE NOT NULL,\n    total_amount DECIMAL(10,2),\n    status VARCHAR(20)\n);\n\nCREATE TABLE public.products (\n    id SERIAL PRIMARY KEY,\n    name VARCHAR(100) NOT NULL,\n    category VARCHAR(50),\n    price DECIMAL(10,2)\n);"
            },
            {
              "name": "train_documentation",
              "value": "# Hệ thống Quản lý Bán hàng\n\n## Bảng customers (Khách hàng)\n- id: Mã khách hàng (tự động tăng)\n- name: Tên đầy đủ của khách hàng\n- email: Địa chỉ email (không trùng lặp)\n- country: Quốc gia (ISO code: VN, US, JP...)\n- created_at: Thời điểm tạo tài khoản\n\n## Bảng orders (Đơn hàng)\n- id: Mã đơn hàng\n- customer_id: Liên kết với customers.id\n- order_date: Ngày đặt hàng\n- total_amount: Tổng giá trị đơn hàng (có thể NULL nếu chưa tính)\n- status: Trạng thái (pending, completed, cancelled)\n\n## Bảng products (Sản phẩm)\n- id: Mã sản phẩm\n- name: Tên sản phẩm\n- category: Danh mục (electronics, clothing, food...)\n- price: Giá bán\n\n## Business Rules\n- Sử dụng total_amount::numeric để tính toán với DECIMAL\n- Đơn hàng có status='completed' mới được tính doanh thu\n- Country code theo chuẩn ISO 3166-1 alpha-2"
            },
            {
              "name": "train_sql_question_1",
              "value": "Tổng số khách hàng hiện tại"
            },
            {
              "name": "train_sql_1",
              "value": "SELECT COUNT(*) as total_customers FROM customers;"
            },
            {
              "name": "train_sql_question_2",
              "value": "Top 10 quốc gia có nhiều khách hàng nhất"
            },
            {
              "name": "train_sql_2",
              "value": "SELECT country, COUNT(*) as customer_count \nFROM customers \nGROUP BY country \nORDER BY customer_count DESC \nLIMIT 10;"
            },
            {
              "name": "train_sql_question_3",
              "value": "Doanh thu theo tháng trong năm 2024"
            },
            {
              "name": "train_sql_3",
              "value": "SELECT \n    EXTRACT(MONTH FROM order_date) as month,\n    SUM(total_amount::numeric) as revenue\nFROM orders\nWHERE EXTRACT(YEAR FROM order_date) = 2024\n    AND status = 'completed'\nGROUP BY month\nORDER BY month;"
            }
          ]
        }
      },
