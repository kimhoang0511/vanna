    {
      "parameters": {
        "jsCode": "// Summarize training results\nconst verifyResponse = $input.first().json;\n\nconst trainingItems = verifyResponse.data || [];\nconst summary = {\n  success: true,\n  total_items: trainingItems.length,\n  breakdown: {\n    ddl: 0,\n    documentation: 0,\n    sql: 0\n  },\n  items: trainingItems\n};\n\n// Count by type\ntrainingItems.forEach(item => {\n  if (item.training_data_type === 'ddl') summary.breakdown.ddl++;\n  if (item.training_data_type === 'documentation') summary.breakdown.documentation++;\n  if (item.training_data_type === 'sql') summary.breakdown.sql++;\n});\n\nreturn { json: summary };"
      },
