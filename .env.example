# ================================================================
# LLM PROVIDER CONFIGURATION
# ================================================================

# Choose LLM provider: "gemini" (default, FREE) or "openai"
LLM_PROVIDER=gemini

# ================================================================
# GOOGLE GEMINI CONFIGURATION (if LLM_PROVIDER=gemini)
# ================================================================

# Google Gemini API Key (lấy FREE tại https://makersuite.google.com/app/apikey)
GOOGLE_API_KEY=AIzaSy...

# Gemini Model (default: gemini-2.0-flash-exp)
# Options: gemini-2.0-flash-exp, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash-exp

# Gemini Temperature (0.0-1.0, default: 0.7)
GEMINI_TEMPERATURE=0.7

# ================================================================
# OPENAI CONFIGURATION (if LLM_PROVIDER=openai)
# ================================================================

# OpenAI API Key (nếu dùng OpenAI)
OPENAI_API_KEY=sk-proj-xxx...

# OpenAI Model (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# OpenAI Temperature (0.0-1.0, default: 0.7)
OPENAI_TEMPERATURE=0.7

# ================================================================
# EMBEDDING CONFIGURATION (Optional - recommended for Vietnamese)
# ================================================================

# Hugging Face API Key (cho BGE-M3 embeddings - hiểu tiếng Việt tốt)
# Lấy tại: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxx...

# PostgreSQL Connection (Railway hoặc bất kỳ)
DB_HOST=nozomi.proxy.rlwy.net
DB_PORT=26750
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=xxx...

# API Configuration
API_KEY=your-secret-api-key-here

# Environment
ENVIRONMENT=production

# ChromaDB Configuration (disable telemetry to avoid warnings)
ANONYMIZED_TELEMETRY=False
CHROMA_SERVER_NOFILE=65535
